node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# pr-self-review working files (baseline.json IS committed, see the skill)
.claude/pr-self-review/*
!.claude/pr-self-review/baseline.json

# scripts/check.sh gate logs (implementer inner loop)
.claude/implementer/

# /run-plan run state: plan, findings rounds, verifier matrices
.claude/sdd/

# emdash worktree config (local)
.emdash.json

# workflow-retro: report.md, metrics.json and history.jsonl are committed;
# the raw per-agent prompts and hand-backs stay local
.claude/workflow-retro/*/prompts/
.claude/workflow-retro/*/reports/

# LLM eval run output (see .claude/evals/*/README.md)
.claude/evals/*/workspace/

# /dependency-checker run output (metrics.json + report.md per run date) — local only
.claude/dependency-checker/
