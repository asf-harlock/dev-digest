# Copy to `.env` if you run `mcp/` outside of `.mcp.json` (e.g. via the
# Inspector CLI). When launched through `.mcp.json`, only `DEVDIGEST_API_URL`
# is set there — the rest fall back to the defaults below.

# Base URL of the running @devdigest/api server. Start it with
# ./scripts/dev.sh from the repo root before connecting.
DEVDIGEST_API_URL=http://localhost:3001

# How long run_agent_on_pr polls GET /runs/:id before returning
# {status:'running'} and telling the caller to use get_findings instead.
DEVDIGEST_MCP_RUN_TIMEOUT_MS=55000

# Poll interval while waiting for a review run to finish.
DEVDIGEST_MCP_POLL_INTERVAL_MS=2000
